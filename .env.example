# ─── LLM Provider ─────────────────────────────────────────────────────
# Options: "gemini" (free tier), "ollama" (local), "anthropic" (paid)
LLM_PROVIDER=gemini

# ─── Google Gemini (free tier via AI Studio) ──────────────────────────
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── Ollama (local fallback, requires `pip install vortex[ollama]`) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Anthropic (optional, requires `pip install vortex[anthropic]`) ───
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ─── Vector Store ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# ─── Observability (self-hosted Arize Phoenix) ────────────────────────
# Uncomment to enable tracing. Start Phoenix with: docker compose up phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4318
